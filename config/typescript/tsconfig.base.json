{
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": ["@org/source"],
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "rewriteRelativeImportExtensions": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@paideon/types": ["packages/types/src/index.ts"],
      "@paideon/types/*": ["packages/types/src/*"],
      "@paideon/database": ["packages/database/src/index.ts"],
      "@paideon/database/*": ["packages/database/src/*"],
      "@paideon/ui": ["packages/ui/src/index.ts"],
      "@paideon/ui/*": ["packages/ui/src/*"],
      "@paideon/tokens": ["packages/tokens/src/index.ts"],
      "@paideon/tokens/*": ["packages/tokens/src/*"],
      "@paideon/transport": ["packages/transport/src/index.ts"],
      "@paideon/transport/*": ["packages/transport/src/*"],
      "@paideon/contracts": ["packages/contracts/src/index.ts"],
      "@paideon/contracts/*": ["packages/contracts/src/*"],
      "@paideon/auth-utils": ["packages/auth-utils/src/index.ts"],
      "@paideon/auth-utils/*": ["packages/auth-utils/src/*"]
    }
  }
}
