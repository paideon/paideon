{
  "name": "paideon",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=24.9.0"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "nx run-many -t lint",
    "test": "nx run-many -t test",
    "build": "nx run-many -t build",
    "typecheck": "nx run-many -t typecheck",
    "dev:portal": "nx dev portal",
    "dev:api": "nx serve api",
    "db:generate": "pnpm --filter @paideon/database generate",
    "db:migrate": "pnpm --filter @paideon/database migrate",
    "db:seed": "pnpm --filter @paideon/database exec prisma db seed",
    "db:studio": "pnpm --filter @paideon/database studio",
    "smoke:library": "node scripts/library-smoke.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nx/eslint": "23.3.0",
    "@nx/eslint-plugin": "23.3.0",
    "@nx/jest": "23.3.0",
    "@nx/js": "23.3.0",
    "@nx/next": "23.3.0",
    "@paideon/eslint-config": "workspace:*",
    "@paideon/typescript-config": "workspace:*",
    "@swc/core": "1.16.18",
    "@swc/helpers": "0.5.23",
    "@swc/jest": "~0.2.38",
    "@types/jest": "^30.0.0",
    "@types/node": "^24",
    "eslint": "^10.0.0",
    "jest": "30.3.0",
    "nx": "23.3.0",
    "prettier": "^3.6.2",
    "tslib": "^2.8.1",
    "typescript": "~6.0.3"
  }
}
