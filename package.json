{
  "name": "paideon",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "format": "prettier --config ./config/prettier/.prettierrc --ignore-path ./config/prettier/.prettierignore --write \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "format:check": "nx format:check",
    "lint": "nx run-many -t lint",
    "test": "nx run-many -t test",
    "build": "nx run-many -t build",
    "typecheck": "nx run-many -t typecheck",
    "dev:portal": "nx dev portal",
    "dev:api": "nx serve api",
    "db:generate": "pnpm --filter @paideon/database generate",
    "db:migrate": "pnpm --filter @paideon/database migrate",
    "db:seed": "pnpm --filter @paideon/database exec prisma db seed",
    "db:studio": "pnpm --filter @paideon/database studio",
    "smoke:library": "node scripts/library-smoke.mjs"
  },
  "prettier": "./config/prettier/.prettierrc",
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@nx/eslint": "22.5.2",
    "@nx/eslint-plugin": "22.5.2",
    "@nx/jest": "22.5.2",
    "@nx/js": "22.5.2",
    "@nx/next": "22.5.2",
    "@nx/playwright": "22.5.2",
    "@nx/react": "22.5.2",
    "@nx/webpack": "22.5.2",
    "@playwright/test": "^1.36.0",
    "@swc-node/register": "1.11.1",
    "@swc/core": "1.15.8",
    "@swc/helpers": "0.5.18",
    "@swc/jest": "~0.2.38",
    "@types/jest": "^30.0.0",
    "@types/node": "20.19.9",
    "eslint": "^9.8.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.1",
    "eslint-plugin-react": "7.35.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "jest": "^30.0.2",
    "jest-util": "^30.0.2",
    "nx": "22.5.2",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.40.0",
    "webpack-cli": "^5.1.4"
  }
}
