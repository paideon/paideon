{
  "name": "paideon",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@11.28.5+sha512.484563d30b4c2ad27cb48aa94ff2b302dbcebc8ff6bf28816c2589886e146ce7f76f354f3bc1a438e6f5e9768c302aa0a6f7add8232903cd4cf81426cbc14d9e",
  "engines": {
    "node": ">=24.9.0"
  },
  "scripts": {
    "format": "prettier --config ./config/prettier/.prettierrc --ignore-path ./config/prettier/.prettierignore --write \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "format:check": "nx format:check",
    "lint": "nx run-many -t lint",
    "test": "nx run-many -t test",
    "build": "nx run-many -t build",
    "typecheck": "nx run-many -t typecheck",
    "dev:portal": "nx dev portal",
    "dev:api": "nx serve api",
    "db:generate": "pnpm --filter @paideon/database generate",
    "db:migrate": "pnpm --filter @paideon/database migrate",
    "db:seed": "pnpm --filter @paideon/database exec prisma db seed",
    "db:studio": "pnpm --filter @paideon/database studio",
    "smoke:library": "node scripts/library-smoke.mjs"
  },
  "prettier": "./config/prettier/.prettierrc",
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@nx/eslint": "23.3.0",
    "@nx/eslint-plugin": "23.3.0",
    "@nx/jest": "23.3.0",
    "@nx/js": "23.3.0",
    "@nx/next": "23.3.0",
    "@nx/playwright": "23.3.0",
    "@nx/react": "23.3.0",
    "@nx/webpack": "23.3.0",
    "@playwright/test": "^1.64.0",
    "@swc-node/register": "1.12.1",
    "@swc/core": "1.16.18",
    "@swc/helpers": "0.5.23",
    "@swc/jest": "~0.2.38",
    "@types/jest": "^30.0.0",
    "@types/node": "^24",
    "eslint": "^10.0.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.1",
    "eslint-plugin-react": "7.35.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "jest": "30.3.0",
    "jest-util": "^30.0.2",
    "nx": "23.3.0",
    "prettier": "^3.6.2",
    "ts-jest": "29.4.14",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "webpack-dev-server": "5.2.6",
    "webpack": "5.111.1"
  }
}
