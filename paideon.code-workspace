{
  "folders": [
    {
      "name": "ROOT",
      "path": ".",
    },
    {
      "name": "API",
      "path": "apps/api",
    },
    {
      "name": "PORTAL",
      "path": "apps/portal",
    },
    {
      "name": "DATABASE",
      "path": "packages/database",
    },
    {
      "name": "UI",
      "path": "packages/ui",
    },
    {
      "name": "TOKENS",
      "path": "packages/tokens",
    },
    {
      "name": "CONFIG",
      "path": "packages/config",
    },
    {
      "name": "CONTRACTS",
      "path": "packages/contracts",
    },
  ],
  "settings": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "eslint.useFlatConfig": true,
    "eslint.workingDirectories": [{ "mode": "auto" }],
    "js/ts.preferences.importModuleSpecifier": "non-relative",
    "files.exclude": {
      "apps": false,
      "packages": false,
      "tooling": false,
      "**/node_modules": true,
      "**/.next": true,
      "**/dist": true,
      "**/out-tsc": true,
      "**/test-output": true,
      "**/.nx": true,
      ".vscode": true,
      ".github": true,
    },
    "search.exclude": {
      "**/generated": true,
      "**/prisma/migrations": true,
      "**/pnpm-lock.yaml": true,
    },
  },
}
