// =============================================================================
// Paideon — schema.prisma
// Version: 5.0
// Database: PostgreSQL 16
// Tables: 32  (pruned from 107: kept what the code uses + people-data candidates)
// =============================================================================

generator client {
  provider = "prisma-client"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// ENUMERATIONS
// =============================================================================

// What KIND of person this is. Descriptive only: it picks the profile table,
// the ID prefix and the library loan limit. It grants NOTHING. What a person
// may do comes only from CapabilityGrant rows (see below).
enum PersonKind {
  STUDENT
  TEACHER
  PARENT
  STAFF
}

// Where a student stands with the school. Separate from the account's
// UserStatus: setting a student to anything but ACTIVE also deactivates the
// account (TRANSFERRED_OUT and LEFT become INACTIVE, GRADUATED stays GRADUATED).
enum StudentStatus {
  ACTIVE
  TRANSFERRED_OUT
  LEFT
  GRADUATED
}

// Language of a student's local-script name.
enum LocalNameLanguage {
  SINHALA
  TAMIL
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  GRADUATED
  INACTIVE
}

enum Gender {
  MALE
  FEMALE
}

enum MediumOfInstruction {
  SINHALA
  TAMIL
  ENGLISH
}

enum EmploymentType {
  PERMANENT
  CONTRACT
  VISITING
}

enum LanguageProficiency {
  EXCELLENT
  AVERAGE
  POOR
}

enum Relationship {
  FATHER
  MOTHER
  GUARDIAN
  GRANDPARENT
  SIBLING
  OTHER
}

enum SchoolType {
  NATIONAL
  PROVINCIAL
  PRIVATE
  INTERNATIONAL
}

enum QualificationType {
  OL
  AL
  DEGREE
  MASTERS
  PHD
  DIPLOMA
  PROFESSIONAL
  NCOE
  OTHER
}

enum MediaPurpose {
  PROFILE_IMAGE
  BOOK_COVER
  VAULT_FILE
  DAMAGE_PHOTO
  SCHOOL_LOGO
  ASSIGNMENT_FILE
  CERTIFICATE
  MEDICAL_DOCUMENT
  CLUB_PHOTO
  EVENT_PHOTO
  OTHER
}

enum BookStatus {
  AVAILABLE
  CHECKED_OUT
  RESERVED
  DAMAGED
  LOST
  UNDER_REPAIR
  WITHDRAWN
}

enum BookCondition {
  NEW
  GOOD
  FAIR
  POOR
  DAMAGED
}

enum CopyStatus {
  AVAILABLE
  ON_LOAN
  RESERVED
  DAMAGED
  LOST
  UNDER_REPAIR
  WITHDRAWN
}

enum LoanStatus {
  ACTIVE
  RETURNED
  OVERDUE
  RENEWED
  LOST
}

enum FineType {
  OVERDUE
  DAMAGE
  LOST_BOOK
}

enum FineStatus {
  PENDING
  PAID
  WAIVED
  PARTIAL
}

// =============================================================================
// LAYER 0 — FOUNDATION
// =============================================================================

model School {
  id                 String     @id @default(cuid())
  schoolCode         String     @unique
  name               String
  nameShort          String?
  nameSinhala        String?
  nameTamil          String?
  slug               String     @unique
  domain             String?    @unique
  logoMediaId        String?
  type               SchoolType
  medium             String[]
  province           String?
  district           String?
  dsDivision         String?
  gnDivision         String?
  addressId          String?
  phone              String?
  fax                String?
  email              String?
  website            String?
  principalName      String?
  principalEmail     String?
  establishedYear    Int?
  registrationNumber String?
  censusId           String?
  isActive           Boolean    @default(true)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  address Address? @relation(fields: [addressId], references: [id])
  logo    Media?   @relation("SchoolLogo", fields: [logoMediaId], references: [id])

  // Layer 0
  settings           SchoolSettings?
  academicYears      AcademicYear[]
  paideonIdSequences PaideonIdSequence[]

  // Layer 2
  users User[]

  // Layer 3
  studentProfiles   StudentProfile[]

  // Layer 4
  teacherProfiles TeacherProfile[]
  teacherSubjects TeacherSubject[]

  // Layer 5
  parentProfiles ParentProfile[]

  // Layer 6
  staffProfiles StaffProfile[]

  // Layer 7
  parentStudentLinks ParentStudentLink[]
  emergencyContacts  EmergencyContact[]

  // Layer 11
  media Media[]

  // Layer 13
  subjects         Subject[]
  streams          Stream[]
  classes          Class[]
  classTeachers    ClassTeacher[]
  classEnrollments ClassEnrollment[]

  // Layer 18
  books              Book[]
  bookCopies         BookCopy[]
  loans              Loan[]
  fines              Fine[]
  libraryConfig      LibraryConfig?

  // Layer 29
  qualification   Qualification[]
  serviceRecord   ServiceRecord[]

  // People
  capabilityGrants     CapabilityGrant[]
  studentStatusChanges StudentStatusChange[]
}

model SchoolSettings {
  id                     String   @id @default(cuid())
  schoolId               String   @unique
  libraryEnabled         Boolean  @default(true)
  vaultEnabled           Boolean  @default(true)
  lmsEnabled             Boolean  @default(false)
  examsEnabled           Boolean  @default(false)
  attendanceEnabled      Boolean  @default(false)
  timetableEnabled       Boolean  @default(false)
  clubsEnabled           Boolean  @default(false)
  transportEnabled       Boolean  @default(false)
  feeManagementEnabled   Boolean  @default(false)
  messagingEnabled       Boolean  @default(true)
  primaryColor           String   @default("#0066CC")
  secondaryColor         String   @default("#004499")
  timezone               String   @default("Asia/Colombo")
  academicYearStartMonth Int      @default(1)
  defaultLanguage        String   @default("si")
  updatedAt              DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id])
}

model AcademicYear {
  id        String   @id @default(cuid())
  schoolId  String
  year      Int
  label     String
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)
  termCount Int      @default(3)
  createdAt DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id])

  classes              Class[]
  classEnrollments     ClassEnrollment[]
  teacherSubjects      TeacherSubject[]

  @@unique([schoolId, year])
}

model PaideonIdSequence {
  id         String   @id @default(cuid())
  schoolId   String
  kind       PersonKind
  lastNumber Int      @default(0)
  updatedAt  DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, kind])
}

// =============================================================================
// LAYER 1 — ADDRESSES
// =============================================================================

model Address {
  id               String   @id @default(cuid())
  line1            String
  line2            String?
  village          String?
  gnDivision       String?
  gnDivisionNumber String?
  dsDivision       String?
  city             String?
  district         String?
  province         String?
  postalCode       String?
  country          String   @default("LK")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  schools            School[]
  studentProfiles    StudentProfile[]
  teacherProfiles    TeacherProfile[]
  parentProfilesHome ParentProfile[]    @relation("ParentHomeAddress")
  parentProfilesWork ParentProfile[]    @relation("ParentWorkAddress")
  staffProfiles      StaffProfile[]
  emergencyContacts  EmergencyContact[]
}

// =============================================================================
// LAYER 2 — IDENTITY & AUTH
// Raw SQL: chk_user_status. (chk_user_role belongs to the old `role` column: drop it in the migration.)
// =============================================================================

model User {
  id                String     @id @default(cuid())
  schoolId          String
  paideonId         String     @unique
  email             String
  emailVerified     Boolean    @default(false)
  password          String?
  kind              PersonKind
  status            UserStatus @default(PENDING)
  firstName         String
  lastName          String
  displayName       String?
  profileImageId    String?
  phone             String?
  whatsappNumber    String?
  cardNumber        String     @unique
  cardQrCode        String?
  totpSecret        String? // encrypted - never expose in API responses
  totpEnabled       Boolean    @default(false)
  lastLoginAt       DateTime?
  passwordChangedAt DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  deletedAt         DateTime?

  school       School @relation(fields: [schoolId], references: [id])
  profileImage Media? @relation("UserProfileImage", fields: [profileImageId], references: [id])

  // Profiles (at most one per kind)
  studentProfile StudentProfile?
  teacherProfile TeacherProfile?
  parentProfile  ParentProfile?
  staffProfile   StaffProfile?

  // What this person may do (see CapabilityGrant)
  capabilityGrants     CapabilityGrant[]
  studentStatusChanges StudentStatusChange[] @relation("StudentStatusChanges")

  // Security
  refreshTokens           RefreshToken[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  totpBackupCodes         TotpBackupCode[]

  // Family
  parentLinks       ParentStudentLink[] @relation("ParentLinks")
  studentLinks      ParentStudentLink[] @relation("StudentLinks")
  emergencyContacts EmergencyContact[]

  // Layer 4 — teacher data (FK to User.id)
  qualifications  Qualification[]
  teacherSubjects TeacherSubject[]

  // Academic
  classTeacherAssignments ClassTeacher[]
  classEnrollments        ClassEnrollment[]

  // Library
  loans           Loan[]
  fines           Fine[]

  // Media
  mediaUploaded           Media[]                   @relation("MediaUploadedBy")
  ServiceRecord           ServiceRecord[]

  @@unique([email, schoolId])
  @@index([schoolId, kind, status])
  @@index([schoolId, deletedAt])
}

// =============================================================================
// LAYER 3 — STUDENT DOMAIN
// migration-02-profiles
// Raw SQL: chk_current_grade, chk_admission_grade
// =============================================================================

model StudentProfile {
  id                      String              @id @default(cuid())
  userId                  String              @unique
  schoolId                String
  admissionNumber         String
  // Local-script name (Sinhala or Tamil) next to the English one on User, and
  // the English name with initials ("K. A. S. Perera") used on printed lists.
  nameLocal               String?
  nameLocalLanguage       LocalNameLanguage?
  nameWithInitials        String?
  enrollmentStatus        StudentStatus       @default(ACTIVE)
  dateOfBirth             DateTime
  gender                  Gender
  nationality             String              @default("Sri Lankan")
  nicNumber               String?
  // Optional. 'Prefer not to say' is stored as the text PREFER_NOT_TO_SAY
  // (see PREFER_NOT_TO_SAY in @paideon/contracts); null means "not recorded".
  religion                String?
  ethnicity               String?
  medium                  MediumOfInstruction
  homeAddressId           String?
  currentGrade            Int
  currentSection          String?
  streamId                String?
  admissionDate           DateTime
  gradeAtAdmission        Int
  previousSchool          String?
  previousSchoolDistrict  String?
  isTransferStudent       Boolean             @default(false)
  olIndexNumber           String?
  olYear                  Int?
  alIndexNumber           String?
  alYear                  Int?
  grade5ScholarshipYear   Int?
  grade5ScholarshipResult String?
  bloodGroup              String?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  user        User     @relation(fields: [userId], references: [id])
  school      School   @relation(fields: [schoolId], references: [id])
  homeAddress Address? @relation(fields: [homeAddressId], references: [id])
  stream      Stream?  @relation(fields: [streamId], references: [id])

  @@unique([admissionNumber, schoolId])
}

// A change of a student's standing (transferred out, left, graduated, came
// back), kept as history. The current value lives in StudentProfile.
model StudentStatusChange {
  id            String        @id @default(cuid())
  schoolId      String
  studentUserId String
  fromStatus    StudentStatus
  toStatus      StudentStatus
  effectiveDate DateTime
  reason        String?
  changedBy     String
  createdAt     DateTime      @default(now())

  school  School @relation(fields: [schoolId], references: [id])
  student User   @relation("StudentStatusChanges", fields: [studentUserId], references: [id])

  @@index([studentUserId, createdAt])
}

// ONE thing a person may do, and where. This table is the only source of
// authority in the app (the old single `role` column is gone). Roles are just
// presets used to create several grants at once (CAPABILITY_PRESETS in
// @paideon/contracts).
//
//   capability  e.g. 'people.read' (CAPABILITY_VALUES in @paideon/contracts)
//   scope       'SCHOOL', 'GRADE:7' or 'CLASS:<classId>'
model CapabilityGrant {
  id         String   @id @default(cuid())
  schoolId   String
  userId     String
  capability String
  scope      String   @default("SCHOOL")
  grantedBy  String?
  grantedAt  DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([userId, capability, scope])
  @@index([userId])
  @@index([schoolId, capability])
}

// =============================================================================
// LAYER 4 — TEACHER DOMAIN
// migration-02-profiles
// =============================================================================

model TeacherProfile {
  id                           String              @id @default(cuid())
  userId                       String              @unique
  schoolId                     String
  employeeId                   String
  dateOfBirth                  DateTime
  gender                       Gender
  nicNumber                    String
  passportNumber               String?
  religion                     String?
  ethnicity                    String?
  medium                       MediumOfInstruction
  homeAddressId                String?
  residentialDistrict          String?
  distanceFromSchoolKm         Float?
  department                   String?
  designation                  String?
  employmentType               EmploymentType
  recruitmentMethod            String?
  appointmentDate              DateTime
  currentSchoolAppointmentDate DateTime
  confirmationStatus           String
  confirmationDate             DateTime?
  probationExtensionReason     String?
  salaryGrade                  String?
  basicSalaryLKR               Int?
  salaryIncrementDate          DateTime?
  wopPensionNumber             String?
  pspfNumber                   String?
  sinhalaReading               LanguageProficiency @default(AVERAGE)
  sinhalaWriting               LanguageProficiency @default(AVERAGE)
  sinhalaSpeaking              LanguageProficiency @default(AVERAGE)
  tamilReading                 LanguageProficiency @default(AVERAGE)
  tamilWriting                 LanguageProficiency @default(AVERAGE)
  tamilSpeaking                LanguageProficiency @default(AVERAGE)
  englishReading               LanguageProficiency @default(AVERAGE)
  englishWriting               LanguageProficiency @default(AVERAGE)
  englishSpeaking              LanguageProficiency @default(AVERAGE)
  isClassTeacher               Boolean             @default(false)
  createdAt                    DateTime            @default(now())
  updatedAt                    DateTime            @updatedAt

  user        User     @relation(fields: [userId], references: [id])
  school      School   @relation(fields: [schoolId], references: [id])
  homeAddress Address? @relation(fields: [homeAddressId], references: [id])

  @@unique([employeeId, schoolId])
}

model Qualification {
  id                 String            @id @default(cuid())
  teacherUserId      String
  schoolId           String
  type               QualificationType
  title              String
  fieldOfStudy       String?
  institution        String
  country            String            @default("LK")
  yearCompleted      Int?
  grade              String?
  olIndexNumber      String?
  alIndexNumber      String?
  certificateMediaId String?
  createdAt          DateTime          @default(now())

  teacher          User   @relation(fields: [teacherUserId], references: [id])
  school           School @relation(fields: [schoolId], references: [id])
  certificateMedia Media? @relation(fields: [certificateMediaId], references: [id])
}

model ServiceRecord {
  id               String    @id @default(cuid())
  teacherUserId    String
  schoolId         String
  institutionName  String
  institutionType  String?
  district         String?
  province         String?
  postHeld         String
  department       String?
  dateArrived      DateTime
  dateDeparted     DateTime?
  transferType     String?
  transferReason   String?
  isCurrentPosting Boolean   @default(false)
  createdAt        DateTime  @default(now())

  teacher User   @relation(fields: [teacherUserId], references: [id])
  school  School @relation(fields: [schoolId], references: [id])
}

model TeacherSubject {
  id                 String   @id @default(cuid())
  teacherUserId      String
  schoolId           String
  subjectId          String
  academicYearId     String
  gradeLevel         String?
  isAppointedSubject Boolean  @default(true)
  createdAt          DateTime @default(now())

  teacher      User         @relation(fields: [teacherUserId], references: [id])
  school       School       @relation(fields: [schoolId], references: [id])
  subject      Subject      @relation(fields: [subjectId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  @@unique([teacherUserId, subjectId, academicYearId, gradeLevel])
}

// =============================================================================
// LAYER 5 — PARENT DOMAIN
// migration-02-profiles
// =============================================================================

model ParentProfile {
  id                       String    @id @default(cuid())
  userId                   String    @unique
  schoolId                 String
  dateOfBirth              DateTime?
  gender                   Gender?
  nicNumber                String?
  passportNumber           String?
  religion                 String?
  occupation               String?
  employer                 String?
  workPhone                String?
  workAddressId            String?
  homeAddressId            String?
  monthlyIncomeLKR         Int?
  educationLevel           String?
  isInElectoralRegister    Boolean   @default(false)
  electoralDistrict        String?
  electoralPollingDivision String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  user        User     @relation(fields: [userId], references: [id])
  school      School   @relation(fields: [schoolId], references: [id])
  workAddress Address? @relation("ParentWorkAddress", fields: [workAddressId], references: [id])
  homeAddress Address? @relation("ParentHomeAddress", fields: [homeAddressId], references: [id])
}

// =============================================================================
// LAYER 6 — NON-ACADEMIC STAFF DOMAIN
// migration-02-profiles
// =============================================================================

model StaffProfile {
  id                     String         @id @default(cuid())
  userId                 String         @unique
  schoolId               String
  employeeId             String
  dateOfBirth            DateTime
  gender                 Gender
  nicNumber              String
  religion               String?
  ethnicity              String?
  homeAddressId          String?
  designation            String
  department             String?
  employmentType         EmploymentType
  salaryScale            String?
  modeOfPayment          String?
  appointmentDate        DateTime
  confirmationDate       DateTime?
  shiftType              String?
  uniformEligible        Boolean        @default(false)
  railwayWarrantEligible Boolean        @default(false)
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  user        User     @relation(fields: [userId], references: [id])
  school      School   @relation(fields: [schoolId], references: [id])
  homeAddress Address? @relation(fields: [homeAddressId], references: [id])

  @@unique([employeeId, schoolId])
}

// =============================================================================
// LAYER 7 — RELATIONS & CONTACTS
// migration-02-profiles
// =============================================================================

model ParentStudentLink {
  id                    String       @id @default(cuid())
  schoolId              String
  parentUserId          String
  studentUserId         String
  relationship          Relationship
  isPrimary             Boolean      @default(false)
  qualityOfRelationship String?
  createdAt             DateTime     @default(now())

  school  School @relation(fields: [schoolId], references: [id])
  parent  User   @relation("ParentLinks", fields: [parentUserId], references: [id])
  student User   @relation("StudentLinks", fields: [studentUserId], references: [id])

  @@unique([parentUserId, studentUserId])
}

model EmergencyContact {
  id             String   @id @default(cuid())
  userId         String
  schoolId       String
  name           String
  relationship   String
  phone          String
  whatsappNumber String?
  addressId      String?
  isPrimary      Boolean  @default(false)
  createdAt      DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id])
  school  School   @relation(fields: [schoolId], references: [id])
  address Address? @relation(fields: [addressId], references: [id])
}

// =============================================================================
// LAYER 8 — HEALTH & WELLBEING
// migration-02-profiles
// RESTRICTED: Only roles with HEALTH_DATA permission can read these tables.
// =============================================================================

// =============================================================================
// LAYER 9 — BEHAVIORAL & COUNSELING
// migration-02-profiles
// RESTRICTED: Only counselors and admins.
// =============================================================================

// =============================================================================
// LAYER 10 — SECURITY
// migration-03-security-media
// =============================================================================

model RefreshToken {
  id                String    @id @default(cuid())
  userId            String
  tokenHash         String    @unique
  expiresAt         DateTime
  createdAt         DateTime  @default(now())
  revokedAt         DateTime?
  replacedByTokenId String?
  ipAddress         String?
  userAgent         String?

  user         User           @relation(fields: [userId], references: [id])
  replacedBy   RefreshToken?  @relation("TokenRotation", fields: [replacedByTokenId], references: [id])
  replacedFrom RefreshToken[] @relation("TokenRotation")

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])
}

model EmailVerificationToken {
  id         String    @id @default(cuid())
  userId     String
  email      String
  tokenHash  String    @unique
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])
}

model TotpBackupCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  udesAt    DateTime?
  createdAt DateTime? @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

// No schoolId — system-level, not per-tenant.
model LoginAttempt {
  id            String   @id @default(cuid())
  email         String
  ipAddress     String
  userAgent     String?
  success       Boolean
  failureReason String?
  attemptedAt   DateTime @default(now())

  @@index([email, attemptedAt])
  @@index([ipAddress, attemptedAt])
}

// Append-only. Never UPDATE or DELETE rows.
model AuditLog {
  id             String   @id @default(cuid())
  schoolId       String?
  actorUserId    String?
  actorRole      String?
  actorPaideonId String?
  action         String
  entityType     String
  entityId       String
  oldValues      Json?
  newValues      Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  @@index([schoolId, action])
  @@index([schoolId, createdAt])
  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// =============================================================================
// LAYER 11 — MEDIA
// migration-03-security-media
// URL derived at read time: https://${bucket}.r2.dev/${key}
// Never store the URL — it may go stale.
// =============================================================================

model Media {
  id         String       @id @default(cuid())
  schoolId   String?
  uploadedBy String?
  bucket     String
  key        String       @unique
  filename   String
  mimeType   String
  sizeBytes  Int
  width      Int?
  height     Int?
  duration   Int?
  purpose    MediaPurpose
  isPublic   Boolean      @default(false)
  createdAt  DateTime     @default(now())
  deletedAt  DateTime?

  school   School? @relation(fields: [schoolId], references: [id])
  uploader User?   @relation("MediaUploadedBy", fields: [uploadedBy], references: [id])

  // Reverse relations
  schoolLogos           School[]               @relation("SchoolLogo")
  userProfileImages     User[]                 @relation("UserProfileImage")
  qualificationCerts    Qualification[]
  bookCovers            Book[]                 @relation("BookCover")
  bookThumbnails        Book[]                 @relation("BookThumbnail")

  @@index([schoolId, purpose])
}

// =============================================================================
// LAYER 12 — SCHOOL INFRASTRUCTURE
// migration-04-infrastructure-academic
// =============================================================================

// =============================================================================
// LAYER 13 — ACADEMIC STRUCTURE
// migration-04-infrastructure-academic
// Raw SQL: chk_class_grade
// =============================================================================

model Subject {
  id          String               @id @default(cuid())
  schoolId    String
  name        String
  nameSinhala String?
  nameTamil   String?
  code        String?
  category    String
  medium      MediumOfInstruction?
  gradeRange  String?
  isActive    Boolean              @default(true)
  createdAt   DateTime             @default(now())

  school School @relation(fields: [schoolId], references: [id])

  teacherSubjects TeacherSubject[]

  @@unique([schoolId, name, gradeRange])
}

model Stream {
  id          String   @id @default(cuid())
  schoolId    String
  name        String
  nameSinhala String?
  code        String?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  school          School           @relation(fields: [schoolId], references: [id])
  studentProfiles StudentProfile[]
  classes         Class[]

  @@unique([schoolId, name])
}

model Class {
  id             String   @id @default(cuid())
  schoolId       String
  academicYearId String
  grade          Int
  section        String
  streamId       String?
  capacity       Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  school       School       @relation(fields: [schoolId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  stream       Stream?      @relation(fields: [streamId], references: [id])

  classTeachers    ClassTeacher[]
  classEnrollments ClassEnrollment[]

  @@unique([schoolId, academicYearId, grade, section])
}

model ClassTeacher {
  id            String   @id @default(cuid())
  classId       String
  teacherUserId String
  schoolId      String
  role          String
  assignedAt    DateTime @default(now())

  class   Class  @relation(fields: [classId], references: [id])
  teacher User   @relation(fields: [teacherUserId], references: [id])
  school  School @relation(fields: [schoolId], references: [id])

  @@unique([classId, teacherUserId, role])
}

model ClassEnrollment {
  id             String   @id @default(cuid())
  schoolId       String
  classId        String
  studentUserId  String
  academicYearId String
  enrolledAt     DateTime @default(now())
  status         String   @default("ACTIVE")
  transferNote   String?

  school       School       @relation(fields: [schoolId], references: [id])
  class        Class        @relation(fields: [classId], references: [id])
  student      User         @relation(fields: [studentUserId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  @@unique([studentUserId, academicYearId])
}

