{
  "extends": "../../config/typescript/tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": false,
    // Required for the `.ts` relative-import convention used throughout
    // this package (mirrors Nexus's tokens package). NOT currently set in
    // config/typescript/tsconfig.base.json — needs adding there (or here)
    // before this package will build in the real repo. TS 5.7+.
    "rewriteRelativeImportExtensions": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
