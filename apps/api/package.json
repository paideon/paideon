{
  "name": "@paideon/api",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "name": "api",
    "targets": {
      "build": {
        "dependsOn": [
          "^build"
        ],
        "executor": "nx:run-commands",
        "options": {
          "command": "tsc -p tsconfig.build.json",
          "cwd": "apps/api"
        }
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "api:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "api:build:development"
          },
          "production": {
            "buildTarget": "api:build:production"
          }
        }
      },
      "test": {
        "options": {
          "passWithNoTests": true
        }
      }
    }
  },
  "dependencies": {
    "@nestjs/common": "^12.0.0",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/jwt": "^12.0.0",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.0.0",
    "@nestjs/throttler": "^6.4.0",
    "@paideon/contracts": "workspace:*",
    "@paideon/database": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.1.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "tslib": "^2.8.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.0.0",
    "@paideon/eslint-config": "workspace:*",
    "@paideon/typescript-config": "workspace:*",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/passport-jwt": "^4.0.1"
  }
}
